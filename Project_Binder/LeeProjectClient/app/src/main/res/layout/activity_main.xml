<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5"
    tools:context=".MainActivity">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AIDL 客户端"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:textColor="#333333"/>

    <!-- 状态卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务状态"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#FF5722"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待连接..."
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#666666"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 结果卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#E8F5E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="调用结果"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="结果将显示在这里"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#333333"
                android:minHeight="80dp"
                android:padding="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 连接控制按钮 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="连接控制"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnCheckApp"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="检查目标应用"
            android:textSize="14sp"
            android:backgroundTint="#607D8B"
            android:layout_marginEnd="5dp"/>

        <Button
            android:id="@+id/btnStartTargetApp"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="启动目标应用"
            android:textSize="14sp"
            android:backgroundTint="#009688"
            android:layout_marginStart="5dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnBindService"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="绑定服务"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="5dp"/>

        <Button
            android:id="@+id/btnUnbindService"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="断开连接"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:enabled="false"
            android:layout_marginStart="5dp"/>

    </LinearLayout>

    <!-- 服务调用按钮 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="服务调用"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnGetRandom"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="获取随机数"
        android:textSize="16sp"
        android:backgroundTint="#2196F3"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnGetInfo"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="获取服务信息"
        android:textSize="16sp"
        android:backgroundTint="#9C27B0"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAddNumbers"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="计算 5 + 3"
        android:textSize="16sp"
        android:backgroundTint="#FF5722"
        android:enabled="false"
        android:layout_marginBottom="20dp"/>

    <!-- 目标应用信息 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E3F2FD">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标服务信息"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="包名: com.example.leeandroidproject"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务: MyAIDLService"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#333333"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>